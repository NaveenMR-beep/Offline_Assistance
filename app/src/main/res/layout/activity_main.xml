<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Offline Phone Assistant"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="On-Device Voice Automation Engine"
        android:textColor="#00F2FE"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- Mic Permission Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#1E1A30"
        android:layout_marginBottom="16dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Microphone Access"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Needed to capture speech queries offline."
                android:textColor="#ADB5BD"
                android:textSize="12sp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_mic_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grant Mic Permission"
                android:backgroundTint="#7952E9"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Accessibility Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#1E1A30"
        android:layout_marginBottom="24dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Accessibility Service"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Needed to control inputs, buttons, and type text in real apps."
                android:textColor="#ADB5BD"
                android:textSize="12sp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_accessibility_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Accessibility Service"
                android:backgroundTint="#7952E9"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Help Instruction Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#212529"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How to trigger assistant:"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Once both permissions are active, the assistant runs in the background. Simply press the Volume Up key or tap the persistent notification overlay to trigger speech listening!"
                android:textColor="#CED4DA"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
